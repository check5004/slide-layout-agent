        "texts": {
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$": {
              "$ref": "#/$defs/Text"
            }
          },
          "title": "Texts",
          "type": "object"
        },
        "charts": {
          "default": {},
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$": {
              "$ref": "#/$defs/TemplateChart"
            }
          },
          "title": "Charts",
          "type": "object"
        },
        "metrics": {
          "default": {},
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$": {
              "$ref": "#/$defs/SignedDatum"
            }
          },
          "title": "Metrics",
          "type": "object"
        },
        "states": {
          "default": {},
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$": {
              "$ref": "#/$defs/Text"
            }
          },
          "title": "States",
          "type": "object"
        }
      },
      "required": [
        "texts"
      ],
      "title": "CatalogContents",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SignedDatum": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "title": "Value",
          "type": "number"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "value",
        "refs"
      ],
      "title": "SignedDatum",
      "type": "object"
    },
    "TemplateChart": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 60,
          "title": "Categories",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/TemplateSeries"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Series",
          "type": "array"
        }
      },
      "required": [
        "series"
      ],
      "title": "TemplateChart",
      "type": "object"
    },
    "TemplateSeries": {
      "additionalProperties": false,
      "properties": {
        "name": {
