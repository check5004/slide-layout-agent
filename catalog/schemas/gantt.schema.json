          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "title": "TemplateSeries",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "mode": {
          "default": "verbatim",
